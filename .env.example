APP_NAME=Mini E-Commerce and Product Warranty Registration System
APP_ENV=development
DEBUG=false
# PostgreSQL is the only supported server database.
# Examples:
#   DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/product_warranty_db
#   DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/product_warranty_db
#   (SQLite ``sqlite:///./local.db`` is accepted for the isolated test suite only.)
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=product_warranty_db
DB_USER=postgres
DB_PASSWORD=
ENVIRONMENT=development
JWT_SECRET_KEY=change-this-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:5173

SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Mini E-Commerce
